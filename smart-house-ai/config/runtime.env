# ─────────────────────────────────────────────
# 実行環境の設定（scripts/ が読み込みます）
# ※ APIキー・パスワード・トークンは絶対に書かないでください。
# ─────────────────────────────────────────────

# Claude Code の実行コマンド
CLAUDE_BIN="claude"

# 出力形式: text（レポート本文がそのまま出る） / json（メタ情報付き）
# レポートを Markdown ファイルとして保存するため通常は text
CLAUDE_OUTPUT_FORMAT="text"

# 使用モデル。空にすると Claude Code の既定モデルを使います。
CLAUDE_MODEL=""

# 1ルーティンあたりのタイムアウト（秒）
ROUTINE_TIMEOUT_SECONDS="900"

# 入力データのディレクトリ（smart-house-ai からの相対パス）
INPUT_DIR="input"

# ログを何日分残すか（自動削除はしません。古いログの一覧を警告表示するだけです）
LOG_RETENTION_DAYS="180"

# 許可ツール。読み取り系のみ。ここを広げる場合は安全性を必ず確認してください。
# ※ Write/Edit は不要です（レポートはスクリプト側が標準出力から保存します）
CLAUDE_ALLOWED_TOOLS="Read,Glob,Grep"
